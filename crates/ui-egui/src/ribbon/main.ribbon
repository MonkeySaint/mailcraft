# ------------------------------------------------------------------------------------------------------------
# Search contextual tab (shown while the search box is active). One definition for both ribbon modes.

surface search
mode both

tab Search | JS2 | more=moreSearch
group Refine | ZR
button S | From | person | search.refine | {"kind":"from"} | OM
button S | Subject | email | search.refine | {"kind":"subject"} | B
toggle S | Has Attachments | attach | search.refine | {"kind":"hasAttachments"} | H | on=tok:hasattachments:yes
drop S | Categorized | categorize | | | G | menu=searchCategorized
drop S | This Week | week | | | W | menu=searchThisWeek
drop S | Sent To | person | | | ST | menu=searchSentTo
toggle S | Unread | unread | search.refine | {"kind":"unread"} | U | on=tok:isread:no
toggle S | Flagged | flag | search.refine | {"kind":"flagged"} | F | on=tok:isflagged:yes
toggle S | Important | importance-high | search.refine | {"kind":"important"} | I1 | on=tok:importance:high
drop S | More | more | | | MR | menu=searchMore
group Scope | ZS
toggle S | All Mailboxes | account | search.scope | {"scope":"allMailboxes"} | A | on=scope:allMailboxes
toggle S | Current Mailbox | inbox | search.scope | {"scope":"currentMailbox"} | C1 | on=scope:currentMailbox
