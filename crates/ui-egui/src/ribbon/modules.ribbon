# Menus

menu calendarNewItems
item | E-mail Message | mail | mail.newEmail | | M
item | Appointment | appointment | mail.newItem | {"kind":"appointment"} | A
item | Meeting | meeting | mail.newItem | {"kind":"meeting"} | E
item | Contact | person | mail.newItem | {"kind":"contact"} | C
item | Task | task | mail.newItem | {"kind":"task"} | T
item | All Day Event | appointment | mail.newItem | {"kind":"appointment"} | V
sep
sub | More Items | new-items | calendarMoreItems | | I

menu calendarMoreItems
item | Recurring Appointment | recurrence | mail.newItem | {"kind":"appointment"} | A
item | Recurring Meeting | recurrence | mail.newItem | {"kind":"meeting"} | C
item | Contact Group | contact-group | mail.newItem | {"kind":"contactGroup"} | G
item | Task Request | task | mail.newItem | {"kind":"taskRequest"} | Q
item | Choose Form... | | mail.newItem | {"kind":"fromForm"} | O
item | Outlook Data File... | | file.newDataFile | | F

menu addCalendar
item | From Address Book... | address-book | calendar.addCalendar | {"source":"addressBook"} | A
item | From Room List... | location | calendar.addCalendar | {"source":"roomList"} | R
item | From Internet... | link | calendar.addCalendar | {"source":"internet"} | I
item | Create New Blank Calendar... | plus | folder.new | | B
item | Open Shared Calendar... | calendar | calendar.addCalendar | {"source":"shared"} | O

menu shareCalendar
item | Calendar | calendar | calendar.share | | C

menu calendarChangeView
item | Calendar | calendar | view.changeView | {"name":"Calendar"} | C
item | Preview | view | view.changeView | {"name":"Preview"} | P
item | List | bullets | view.changeView | {"name":"List"} | L
item | Active | check | view.changeView | {"name":"Active"} | A
sep
