item | 15 Minutes | | calendar.timeScale | {"minutes":15} | 1 | on=mem:timeScale.15
item | 10 Minutes | | calendar.timeScale | {"minutes":10} | 0 | on=mem:timeScale.10
item | 6 Minutes | | calendar.timeScale | {"minutes":6} | M | on=mem:timeScale.6
item | 5 Minutes | | calendar.timeScale | {"minutes":5} | 5 | on=mem:timeScale.5
sep
