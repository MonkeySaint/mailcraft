# Compose window ribbon (plan/outlook/ribbon-compose.md, responsive.md "Compose window"). Only the Classic
# ribbon was observed; the Simplified ribbon is derived from it (every control small, one row). Grammar: see
# main.ribbon. Commands get {"compose": <id>} added by the ribbon.

surface compose
mode classic

tab Message | H
group Clipboard | ZL | c1440=nolabel launch=format.clipboardPane
split L | Paste | paste | format.paste | | V | menu=paste
button S | Cut | cut | format.cut | | X
button S | Copy | copy | format.copy | | C1
toggle S | Format Painter | format-painter | format.formatPainter | | FP | on=painter
group Basic Text | ZB | c900=collapse rows launch=format.fontDialog
combo S | Font | | format.font | {"family":"$value"} | FF | menu=fonts w=118 on=value:font
combo S | Font Size | | format.fontSize | {"pt":"$value"} | FS | menu=fontSizes w=44 on=value:size
button I | Grow Font | zoom-in | format.growFont | | FG
button I | Shrink Font | zoom-out | format.shrinkFont | | FK
split I | Bullets | bullets | format.bullets | | U | menu=bullets on=bullets
split I | Numbering | numbering | format.numbering | | N | menu=numbering on=numbering
button I | Clear Formatting | format-painter | format.clearFormatting | | E
br
toggle I | Bold | bold | format.bold | | 1 | on=bold
toggle I | Italic | italic | format.italic | | 2 | on=italic
toggle I | Underline | underline | format.underline | | 3 | on=underline
split I | Text Highlight Color | highlight | format.highlight | | I1 | menu=highlight
split I | Font Color | font-color | format.color | | FC | menu=fontColor
toggle I | Align Left | align-left | format.align | {"kind":"left"} | AL | on=align:left
toggle I | Center | align-center | format.align | {"kind":"center"} | AC | on=align:center
toggle I | Align Right | align-right | format.align | {"kind":"right"} | AR | on=align:right
button I | Decrease Indent | outdent | format.outdent | | AO
button I | Increase Indent | indent | format.indent | | AI
group Names | ZN | c1100=collapse
button L | Address Book... | address-book | compose.addressBook | | AB
button L | Check Names | check-names | compose.checkNames | | M1
group Include | ZC | c1420=small c1100=collapse
drop L | Attach File... | attach | | | AF | menu=attachFile
split L | Link | link | insert.link | | I2 | menu=link
drop L | Signature | signature | | | AS | menu=signature
group Tags | ZO | c1420=nolabel c1100=collapse launch=compose.messageOptions
drop S | Follow Up | flag | | | W | menu=composeFollowUp
toggle S | High Importance | importance-high | compose.importance | {"level":"high"} | H | on=imp:high oncmd=compose.importance{"level":"normal"}
toggle S | Low Importance | importance-low | compose.importance | {"level":"low"} | L1 | on=imp:low oncmd=compose.importance{"level":"normal"}
group Editor | Z5
button L | Editor | spelling | review.spelling | | C2
group Dark Mode | Z6
toggle L | Switch Background | view | compose.switchBackground | | B | on=lightcanvas

tab Insert | N
group Include | ZC
drop L | Attach File... | attach | | | AF | menu=attachFileInsert
button L | Outlook Item | email | compose.attachItem | | AM
drop L | Business Card | contact-group | | | AA | menu=businessCard
button L | Calendar... | calendar | insert.calendar | | OC
drop L | Signature | signature | | | AS | menu=signature
group Tables | ZB
drop L | Table | table | | | T | menu=table
group Illustrations | ZI
drop L | Pictures | picture | | | P | menu=pictures
drop L | Shapes | new-items | | | SH | menu=shapes
button L | Icons | categorize | insert.icon | | NS
split L | 3D Models | picture | insert.model3d | | S3 | menu=models3d
button L | SmartArt... | quick-steps | insert.smartArt | | M
button L | Chart... | table | insert.chart | | C
drop L | Screenshot | picture | | | SC | menu=screenshot
group Links | ZL
split L | Link | link | insert.link | | I | menu=link
button L | Bookmark... | pin | insert.bookmark | | K
group Text | ZT
drop L | Text Box | note | | | X | menu=textBox
drop L | Quick Parts | quick-steps | | | Q | menu=quickParts
drop L | WordArt | font-color | | | W | menu=wordArt
drop L | Drop Cap | bold | | | RC | menu=dropCap
button S | Date & Time... | today | insert.dateTime | | D
button S | Object... | new-items | insert.object | | J
group Symbols | ZS
split L | Equation | plus | insert.equation | | E | menu=equation
drop L | Symbol | info | | | U | menu=symbol
button L | Horizontal Line | minus | insert.horizontalLine | | H

tab Options | P
group Themes | ZT
drop L | Themes | view | | | TH | menu=themes
drop S | Colors | font-color | | | TC | menu=themeColors
drop S | Fonts | bold | | | TF | menu=themeFonts
drop S | Effects | highlight | | | TE | menu=themeEffects
drop L | Page Color | font-color | | | PC | menu=pageColor
group Show Fields | ZF
toggle L | Bcc | person | compose.showBcc | {"on":"$!on"} | B | on=bcc
toggle L | From | account | compose.showFrom | {"on":"$!on"} | F | on=from
group Encrypt | ZP1
toggle L | Encrypt | private | compose.encrypt | {"on":"$!on"} | PM | on=encrypt
group Tracking | ZK | launch=compose.messageOptions
drop L | Use Voting Buttons | check | | | V | menu=voting
check S | Request a Delivery Receipt | check | compose.deliveryReceipt | {"on":"$!on"} | U | on=dr
check S | Request a Read Receipt | read | compose.readReceipt | {"on":"$!on"} | Q | on=rr
group More Options | ZP2 | launch=compose.messageOptions
drop L | Save Sent Item To | sent | | | S | menu=saveSentTo
toggle L | Delay Delivery | schedule | compose.delayDelivery | | D | on=delay oncmd=compose.delayDelivery{"at":null}
toggle L | Direct Replies To | reply | compose.directRepliesTo | | I | on=replyto oncmd=compose.directRepliesTo{"addresses":""}

tab Format Text | O
group Clipboard | ZL | c1440=nolabel launch=format.clipboardPane
split L | Paste | paste | format.paste | | V | menu=paste
button S | Cut | cut | format.cut | | X
button S | Copy | copy | format.copy | | C
toggle S | Format Painter | format-painter | format.formatPainter | | FP | on=painter
group Format | ZO
toggle S | HTML | email | compose.format | {"kind":"html"} | TH | on=fmt:html
toggle S | Plain Text | note | compose.format | {"kind":"plain"} | TP | on=fmt:plain
toggle S | Rich Text | font-color | compose.format | {"kind":"rich"} | TR | on=fmt:rich
group Font | ZF | rows c900=collapse launch=format.fontDialog
combo S | Font | | format.font | {"family":"$value"} | FF | menu=fonts w=118 on=value:font
combo S | Font Size | | format.fontSize | {"pt":"$value"} | FS | menu=fontSizes w=44 on=value:size
button I | Grow Font | zoom-in | format.growFont | | FG
button I | Shrink Font | zoom-out | format.shrinkFont | | FK
drop I | Change Case | font-color | | | 7 | menu=changeCase
button I | Clear Formatting | format-painter | format.clearFormatting | | E
br
toggle I | Bold | bold | format.bold | | 1 | on=bold
toggle I | Italic | italic | format.italic | | 2 | on=italic
toggle I | Underline | underline | format.underline | | 3 | on=underline
toggle I | Strikethrough | strike | format.strike | | 4 | on=strike
toggle I | Subscript | chevron-down | format.sub | | 5 | on=sub
toggle I | Superscript | chevron-up | format.sup | | 6 | on=sup
split I | Text Highlight Color | highlight | format.highlight | | I | menu=highlight
split I | Font Color | font-color | format.color | | FC | menu=fontColor
group Paragraph | ZP | rows c1100=collapse launch=format.paragraphDialog
split I | Bullets | bullets | format.bullets | | U | menu=bullets on=bullets
split I | Numbering | numbering | format.numbering | | N | menu=numbering on=numbering
drop I | Multilevel List | numbering | | | M | menu=multilevel
button I | Decrease Indent | outdent | format.outdent | | AO
button I | Increase Indent | indent | format.indent | | AI
button I | Sort... | sort | format.sort | | SO
toggle I | Show All | view | format.showMarks | | 8 | on=marks
br
toggle I | Align Left | align-left | format.align | {"kind":"left"} | AL | on=align:left
toggle I | Center | align-center | format.align | {"kind":"center"} | AC | on=align:center
toggle I | Align Right | align-right | format.align | {"kind":"right"} | AR | on=align:right
toggle I | Justify | justify | format.align | {"kind":"justify"} | AJ | on=align:justify
drop I | Line and Paragraph Spacing | numbering | | | K | menu=lineSpacing
split I | Shading | highlight | format.shading | | H | menu=shading
split I | Borders | table | format.borders | {"kind":"bottom"} | B | menu=borders
group Styles | ZS | c1100=collapse launch=format.stylesPane
gallery L | Styles | font-color | | | L | dyn=styles menu=styles w=460
drop L | Change Styles | view | | | G | menu=changeStyles
group Editing | ZN | c1100=collapse
split S | Find... | search | format.find | | FD | menu=find
button S | Replace... | sort | format.replace | | R
drop S | Select | check | | | SL | menu=select
group Zoom | ZZ
button L | Zoom... | zoom-in | format.zoom | | Q

tab Review | V
group Editor | ZP
split L | Spelling and Grammar | spelling | review.spelling | | Q | menu=spelling
button L | Editor | spelling | review.spelling | {"grammar":true} | C
button L | Thesaurus... | address-book | review.thesaurus | | E
button L | Word Count | numbering | review.wordCount | | W
group Speech | Z1
button L | Read Aloud | conversation | review.readAloud | | R1
group Accessibility | ZA
button L | Check Accessibility | person | review.accessibility | | A
group Language | ZL
drop L | Language | email | | | U | menu=language

