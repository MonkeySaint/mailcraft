# ------------------------------------------------------------------------------------------------------------
# Shape Format contextual tab (compose window, while a drawing object is selected). One definition for both
# ribbon modes.

surface shapeformat
mode both

tab Shape Format | JD
group Insert Shapes | ZI
drop L | Shapes | new-items | | | SH | menu=shapes
split S | Text Box | note | insert.textBox | {"preset":"draw"} | TX | menu=drawTextBox
drop S | Edit Shape | new-items | | | E | menu=editShape
group Shape Styles | ZS | launch=drawing.format{"page":"fill"}
drop L | Shape Styles | shape-styles | | | SS | menu=shapeQuickStyles
drop S | Shape Fill | shape-fill | | | SF | menu=shapeFill
drop S | Shape Outline | shape-outline | | | SO | menu=shapeOutline
drop S | Shape Effects | shape-effects | | | SE | menu=shapeEffects
group WordArt Styles | ZW | launch=drawing.format{"page":"effects"}
drop L | Quick Styles | quick-styles | | | Q | menu=wordArtStyles
drop S | Text Fill | text-fill | | | TI | menu=textFill
drop S | Text Outline | text-outline | | | TO | menu=textOutline
drop S | Text Effects | text-effects | | | TE | menu=textEffects
group Text | ZT
drop S | Text Direction | sort | | | TD | menu=textDirection
drop S | Align Text | align-left | | | AT | menu=alignText
drop S | Font | bold | | | FN | menu=drawingFont
split S | Create Link | link | drawing.linkTextBox | | K | menu=textBoxLink
group Accessibility | ZA
button L | Alt Text | info | drawing.altText | | AA
group Arrange | ZR
drop S | Wrap Text | sort | | | TW | menu=wrapText
split S | Bring Forward | chevron-up | drawing.arrange | {"action":"bringForward"} | AF | menu=bringForward
split S | Send Backward | chevron-down | drawing.arrange | {"action":"sendBackward"} | AE | menu=sendBackward
button S | Selection Pane | sort | format.selectionPane | | AP
drop S | Align | align-center | | | AL | menu=alignObjects
drop S | Group | new-items | | | G | menu=groupObjects
drop S | Rotate | redo | | | AY | menu=rotate
button S | Delete | delete | drawing.delete | | D
group Size | ZZ | launch=drawing.format{"page":"size"}
combo S | Height | | drawing.size | {"h":"$value"} | H | menu=drawHeights w=70 on=value:drawH
combo S | Width | | drawing.size | {"w":"$value"} | W | menu=drawWidths w=70 on=value:drawW

